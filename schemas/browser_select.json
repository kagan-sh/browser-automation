{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "option"],
  "properties": {
    "ref": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "A whole-number ref from the latest snapshot. The control is a select."
    },
    "option": {
      "type": "string",
      "minLength": 1,
      "description": "The option's value or its label."
    }
  }
}
