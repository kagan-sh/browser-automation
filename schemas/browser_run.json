{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "script"],
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Session id from browser_open."
    },
    "script": {
      "type": "string",
      "description": "Trusted async JavaScript. Use const p = await browser.getPage(\"main\"); then p.goto, p.snapshot, p.click, p.fill, p.shot."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000,
      "description": "Script timeout in milliseconds. Default 30000."
    }
  }
}
